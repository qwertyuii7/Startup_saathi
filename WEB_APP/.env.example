# AROVA Environment Variables
# Copy to .env.local for local development (never commit secrets).
#
# App runs locally on:
#   http://localhost:3000
# Google Cloud Console → Credentials → OAuth 2.0 Client ID:
#   Authorized JavaScript origins must include http://localhost:3000
#   (this app uses the Google Identity Services ID-token flow — no
#   redirect/callback URL is required).

# App
PORT=3000
NODE_ENV=development

# Database (connection string used by the configured database layer)
DATABASE_URL=

# Authentication (Google OAuth & JWT)
# Server-only — NEVER prefix with NEXT_PUBLIC_.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=
SESSION_SECRET=

# Public Google client ID for GIS (must match GOOGLE_CLIENT_ID).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Groq LLM inference (chat, drafts, analysis synthesis).
# Groq provides LLM inference only — it has no embeddings endpoint.
# Server-only — NEVER prefix with NEXT_PUBLIC_.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b

# Current web search (official government sources prioritized).
# Optional — without it, answers use stored RAG knowledge only.
TAVILY_API_KEY=

# Embeddings provider for RAG indexing/retrieval.
#   EMBEDDING_PROVIDER=local (HuggingFace Xenova/all-MiniLM-L6-v2, 384 dims)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# Qdrant vector database (real retrieval layer).
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=arova_documents

# Document storage provider.
#   STORAGE_PROVIDER=local       (default; files under public/uploads)
#   STORAGE_PROVIDER=cloudinary  (requires the CLOUDINARY_* vars below)
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Upload guardrails
MAX_UPLOAD_MB=15

# Legacy / optional vector-database settings (only set when actually used)
VECTOR_DATABASE_URL=
VECTOR_DATABASE_API_KEY=
STORAGE_URL=
STORAGE_API_KEY=
